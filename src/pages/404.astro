---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <div class="grid-paper">
    <div class="wrap page-head">
      <h1>404: no route to host</h1>
      <p>This page doesn't exist. It may have moved when the site left WordPress. Try the <a href="/notes/">notes list</a> or go to the <a href="/">home page</a>.</p>
    </div>
  </div>
</Base>
