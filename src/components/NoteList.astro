---
import { formatDate, isoDate, type Note } from '../lib';

interface Props { notes: Note[] }
const { notes } = Astro.props;
---
{notes.length === 0 ? (
  <p class="empty">No notes published yet.</p>
) : (
  <ol class="log">
    {notes.map((note) => (
      <li>
        <time datetime={isoDate(note.data.date)}>{formatDate(note.data.date)}</time>
        <div>
          <h3>
            <a href={`/notes/${note.id}/`}>{note.data.title}</a>
            {note.data.draft && <span class="draft">Draft</span>}
          </h3>
          <p>{note.data.description}</p>
        </div>
      </li>
    ))}
  </ol>
)}

<style>
  .log { list-style: none; margin: 0; padding: 0; }
  li {
    display: grid; grid-template-columns: 7.5rem 1fr; gap: 0.25rem 1.5rem;
    padding-block: 1.1rem; border-top: 1px solid var(--rule);
  }
  li:last-child { border-bottom: 1px solid var(--rule); }
  time { color: var(--muted); font-size: 0.9rem; padding-top: 0.2rem; font-variant-numeric: tabular-nums; }
  h3 { font-size: 1.15rem; font-weight: 650; margin: 0 0 0.3rem; }
  h3 a { color: var(--ink); text-decoration: none; }
  h3 a:hover { color: var(--accent); text-decoration: underline; }
  p { margin: 0; color: var(--muted); max-width: 40rem; }
  .draft {
    font-size: 0.75rem; font-weight: 500; margin-left: 0.5rem; vertical-align: middle;
    color: var(--muted); border: 1px dashed var(--muted); border-radius: 4px; padding: 0 0.35rem;
  }
  .empty { color: var(--muted); }
  @media (max-width: 34rem) {
    li { grid-template-columns: 1fr; }
  }
</style>
