---
const links = [
  { href: '/notes/', label: 'Notes' },
  { href: '/lab/', label: 'Lab' },
  { href: '/uses/', label: 'Uses' },
  { href: '/now/', label: 'Now' },
];
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap bar">
    <a class="name" href="/">Gabriel Dinu</a>
    <nav aria-label="Main">
      <ul>
        {links.map(({ href, label }) => (
          <li><a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a></li>
        ))}
        <li><a class="cv" href="https://cv.gabrieldinu.co.uk">CV</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header { border-bottom: 1px solid var(--rule); background: var(--paper); }
  .bar {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: 0.5rem 1.5rem; padding-block: 1rem;
  }
  .name { font-weight: 750; font-size: 1.05rem; color: var(--ink); text-decoration: none; }
  ul { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 1.25rem; list-style: none; margin: 0; padding: 0; }
  nav a { color: var(--muted); text-decoration: none; font-size: 0.97rem; }
  nav a:hover, nav a[aria-current='page'] { color: var(--ink); }
  nav a[aria-current='page'] { text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 2px; }
  nav .cv { color: var(--accent); border: 1px solid var(--accent); border-radius: 4px; padding: 0.1rem 0.55rem; }
  nav .cv:hover { color: var(--paper); background: var(--accent); }
</style>
